# Salin menjadi frontend/.env.local; jalankan npm run dev dari frontend/.
# URL backend lengkap, termasuk prefix /api/v1, tanpa trailing slash.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080/api/v1

# Untuk localhost/127.0.0.1, browser memakai /api/v1 lewat proxy Next.js.
# Target proxy saat ini tetap http://127.0.0.1:8080 (lihat next.config.mjs).
# Mengubah URL lokal di atas saja tidak mengubah target proxy.
# Jika memakai backend remote, isi URL HTTPS yang dapat diakses browser.
# Variabel NEXT_PUBLIC_* bersifat publik: jangan simpan password, JWT_SECRET,
# kredensial database/MinIO, atau API key LLM di frontend.
# Restart dev server setelah mengubah env; build ulang untuk deployment.
